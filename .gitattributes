# cmd.exe misparses LF-only batch files (phantom "'x' is not recognized"
# errors) - keep them CRLF no matter the checkout platform.
*.cmd text eol=crlf

# Mirror image: a shell script with CRLF dies on Linux with
# "bad interpreter: /usr/bin/env bash^M". tools/lint_sim.sh runs in CI.
*.sh  text eol=lf

* text=auto
*.c    text
*.h    text
*.js   text
*.mjs  text
*.md   text
*.html text
*.yml  text

*.png       binary
*.aseprite  binary
*.wasm      binary
